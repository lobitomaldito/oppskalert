VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: free access key from https://web3forms.com to e-mail team@oppskalert.no
# on every "Bestill demo" submission. Leads are saved to Supabase even without this.
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# PostHog project API key + host (EU cloud). Analytics is skipped entirely if unset.
VITE_POSTHOG_TOKEN=your_posthog_project_token_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Opinly content API key. Opinly only issues sk- (secret) keys, no public
# pk- tier, so this stays server-only — the browser never sees it. Used by
# api/opinly/*.js (proxy for the blog pages), api/sitemap.xml.js and
# api/rss.xml.js. Never add a VITE_ prefix to this one.
OPINLY_API_KEY=your_opinly_sk_api_key_here

# Svix signing secret for the Opinly webhook (api/opinly-webhook.js), from
# the Opinly dashboard when you register the webhook endpoint.
SVIX_WEBHOOK_SECRET=your_svix_webhook_secret_here

# Supabase service-role key for the "oppskalert" project (zmefwkqhdamdcjnxxfjl),
# used server-side only by api/admin/dashboard-data.js to read analytics_events.
# Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PIN to unlock /admin/dashboard (own analytics dashboard, reads from
# analytics_events). Pick any string.
DASHBOARD_PIN=your_dashboard_pin_here
